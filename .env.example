# Copy to .env and replace the key locally. Never commit .env.
LLM_PROVIDER=openai
OPENAI_API_KEY=replace_with_your_project_api_key
OPENAI_GENERATOR_MODEL=gpt-4o-mini
OPENAI_EMBEDDER_MODEL=text-embedding-3-small

# Optional, for an OpenAI-compatible endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1
