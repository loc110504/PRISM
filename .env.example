# Copy to .env and replace the key locally. Never commit .env.
LLM_PROVIDER=openai
OPENAI_API_KEY=replace_with_your_project_api_key
OPENAI_GENERATOR_MODEL=gpt-4o-mini
OPENAI_EMBEDDER_MODEL=text-embedding-3-small

# Optional, for an OpenAI-compatible endpoint (e.g. Together AI:
# https://api.together.xyz/v1 with a Together model id such as
# Qwen/Qwen3.8-Flash for OPENAI_GENERATOR_MODEL).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: keep embeddings on a different provider than the generator
# (e.g. generator on Together via LLM_PROVIDER=openai above, embedder still
# on the local Ollama server). Defaults to LLM_PROVIDER when unset.
# LLM_EMBED_PROVIDER=ollama

# Optional: pick which Ollama embedder tag to use when LLM_EMBED_PROVIDER is
# (or defaults to) ollama, e.g. the stronger qwen3-embedding:4b instead of
# configs/base.yaml's default models.embedder (qwen3-embedding:0.6b).
# OLLAMA_EMBEDDER_MODEL=qwen3-embedding:4b
